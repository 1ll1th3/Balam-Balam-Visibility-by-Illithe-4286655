function dominantFeature(edge){
  if(!edge.features.length) return "General/Whole";
  return edge.features.find(f => f && f !== "General/Whole") || edge.features[0];
}

// ---- build hierarchy: root -> group -> subgroup -> leaf(node) ----
const groupsMap = new Map();
DATA.nodes.forEach(n => {
  if(!groupsMap.has(n.group)) groupsMap.set(n.group, new Map());
  const sg = groupsMap.get(n.group);
  if(!sg.has(n.subgroup)) sg.set(n.subgroup, []);
  sg.get(n.subgroup).push(n);
});

const hierarchyData = {
  name: "root",
  children: [...groupsMap.entries()].map(([g, sgMap]) => ({
    name: g,
    children: [...sgMap.entries()].map(([sg, arr]) => ({
      name: sg,
      children: arr.map(n => ({ name: n.id, data: n }))
    }))
  }))
};

