  .size([2 * Math.PI, R_LEAF])
  .separation((a,b) => (a.parent === b.parent ? 1 : 1.6));

const root = tree(d3.hierarchy(hierarchyData)
  .sort((a,b) => d3.ascending(a.data.name, b.data.name)));

const leafByName = new Map(root.leaves().map(d => [d.data.name, d]));
root.leaves().forEach(d => { d.outgoing = []; d.incoming = []; });

const links = DATA.edges.map(e => {
  const s = leafByName.get(e.source), t = leafByName.get(e.target);
  if(!s || !t || s===t) return null;
  const link = {source: s, target: t, edge: e};
  s.outgoing.push(link);
  t.incoming.push(link);
  return link;
}).filter(Boolean);

