// subtle radial guide rings
g.append("g").attr("id","GuideRings").selectAll("circle")
  .data([0.35,0.65,1])
  .join("circle")
  .attr("class","guide-ring")
  .attr("r", f => f*R_LEAF)
  .attr("fill","none");

// group boundary arcs + horizontal (non-radiating) labels
const groupArcG = g.append("g").attr("id","GroupArcs");
const groupLabelG = g.append("g").attr("id","GroupLabels");
const groupArc = d3.arc().innerRadius(R_ARC).outerRadius(R_ARC);
[...groupsMap.keys()].forEach(gname => {
  const leaves = root.leaves().filter(d => d.data.data.group === gname);
  if(!leaves.length) return;
  const angles = leaves.map(d=>d.x);
  const a0 = d3.min(angles), a1 = d3.max(angles);
  const pad = 0.012;
  groupArcG.append("path").attr("class","group-arc")
    .attr("d", groupArc({startAngle:a0-pad, endAngle:a1+pad}));

  const mid = (a0+a1)/2;
  const lx = R_LABEL * Math.sin(mid);
  const ly2 = -R_LABEL * Math.cos(mid);
  let anchor = "middle";
  if (lx > 8) anchor = "start";
  else if (lx < -8) anchor = "end";
  groupLabelG.append("text")
    .attr("class","group-label kox-text")
    .attr("x", lx).attr("y", ly2)
    .attr("text-anchor", anchor)
    .attr("dy","0.32em")
    .text(gname.toUpperCase());
});

// links — dash pattern encodes the logged visible feature
const linkPaths = g.append("g").attr("id","Sightlines").attr("fill","none")
  .selectAll("path")
  .data(links)
  .join("path")
  .attr("class","link")
  .attr("stroke-dasharray", d => FEATURE_PATTERNS[dominantFeature(d.edge)] || null)
  .attr("d", d => lineGen(d.source.path(d.target)));

// nodes (leaves) — labels radiate outward
const node = g.append("g").attr("id","Nodes").selectAll("g")
  .data(root.leaves())
  .join("g")
  .attr("class","node")
  .attr("transform", d => `rotate(${d.x*180/Math.PI-90}) translate(${d.y},0)`);

node.append("circle").attr("r", 0.55);

node.append("text")
  .attr("class","kox-text")
  .attr("dy","0.31em")
  .attr("x", d => d.x < Math.PI ? 2 : -2)
  .attr("text-anchor", d => d.x < Math.PI ? "start" : "end")
  .attr("transform", d => d.x >= Math.PI ? "rotate(180)" : null)
  .text(d => d.data.name);

// ---------- knockouts: cut the grid out from behind every text block ----------
function addBlockKnockout(gEl, padX, padY){
  const bbox = gEl.getBBox();
  const rect = document.createElementNS(svgNS,"rect");
  rect.setAttribute("x", bbox.x-padX); rect.setAttribute("y", bbox.y-padY);
  rect.setAttribute("width", bbox.width+2*padX); rect.setAttribute("height", bbox.height+2*padY);
  rect.setAttribute("class","knockout");
  gEl.insertBefore(rect, gEl.firstChild);
}
function addTextKnockout(tEl){
  const bbox = tEl.getBBox();
  const rect = document.createElementNS(svgNS,"rect");
  rect.setAttribute("x", bbox.x-0.6); rect.setAttribute("y", bbox.y-0.4);
  rect.setAttribute("width", bbox.width+1.2); rect.setAttribute("height", bbox.height+0.8);
  rect.setAttribute("class","knockout");
  const tf = tEl.getAttribute("transform");
  if(tf) rect.setAttribute("transform", tf);
  tEl.parentNode.insertBefore(rect, tEl);
}
(function buildAllKnockouts(){
  svg.selectAll(".knockout").remove();
  addBlockKnockout(document.getElementById("TitleBlock"), 2.5, 2);
  addBlockKnockout(document.getElementById("LegendBlock"), 3, 2);
  addBlockKnockout(document.getElementById("DisclaimerBlock"), 2.5, 2);
  document.querySelectorAll(".group-label.kox-text").forEach(addTextKnockout);
  document.querySelectorAll("#Nodes text.kox-text").forEach(addTextKnockout);
})();

// ---------- hover picture ----------
// Looks for a file named after the node code inside a folder called "images"
// sitting next to this HTML file. e.g. hovering LAWN looks for images/LAWN.jpg,
// then images/LAWN.jpeg, images/LAWN.png, images/LAWN.webp. First one that
// exists is shown; if none exist, nothing is shown.
const IMG_DIR  = "images/";
const IMG_EXTS = [".jpg",".jpeg",".png",".webp"];
const nodeImg  = document.getElementById("nodeImg");
const imgHint  = document.getElementById("imgHint");

function showImage(id){
  let i = 0;
  nodeImg.style.display = "none";
  imgHint.style.display = "none";
  nodeImg.onload  = () => { nodeImg.style.display = "block"; imgHint.style.display = "none"; };
  nodeImg.onerror = () => {
    i++;
    if(i < IMG_EXTS.length){ nodeImg.src = IMG_DIR + id + IMG_EXTS[i]; }
    else {
      // delete these two lines if you don't want the reminder
      imgHint.textContent = "no picture yet — add " + IMG_DIR + id + ".jpg";
      imgHint.style.display = "block";
    }
  };
  nodeImg.src = IMG_DIR + id + IMG_EXTS[0];
}
function hideImage(){
  nodeImg.onerror = null; nodeImg.onload = null;
  nodeImg.style.display = "none";
  imgHint.style.display = "none";
}

// ---------- hover -> read the data ----------
function nodeDetail(d){
  const n = d.data.data;
  const out = d.outgoing.map(l=>l.edge).sort((a,b)=>a.target.localeCompare(b.target));
  const inn = d.incoming.map(l=>l.edge).sort((a,b)=>a.source.localeCompare(b.source));
  const row = (e, other) => {
    const on = leafByName.get(other).data.data;
    const feat = e.features.length ? e.features.join(', ') : 'general/whole';
    const capTxt = on.capacity ? `cap. ${on.capacity}` : 'cap. unknown';
    return `<div class="conn"><b>${other}</b> — ${on.desc}
      <span>${capTxt} · via ${feat}${e.weight>1?` · logged ×${e.weight}`:''}</span></div>`;
  };
  let html = `<h2>${n.group} / ${n.subgroup}</h2><p class="id">${n.id}</p><p class="desc">${n.desc}</p>`;
  html += `<div class="rowgrp out"><h3>Can see (${out.length})</h3>` +
    (out.length ? out.map(e=>row(e,e.target)).join("") : `<div class="empty">none logged</div>`) + `</div>`;
  html += `<div class="rowgrp in"><h3>Seen from (${inn.length})</h3>` +
    (inn.length ? inn.map(e=>row(e,e.source)).join("") : `<div class="empty">none logged</div>`) + `</div>`;
  document.getElementById("detail").innerHTML = html;
}

node.on("mouseenter", (event, d) => {
  linkPaths
    .classed("out", l => l.source === d)
    .classed("in", l => l.target === d)
    .filter(l => l.source===d || l.target===d)
    .raise();
  linkPaths.style("stroke-opacity", l => (l.source===d || l.target===d) ? null : 0.06);

  node.classed("hovered", nd => nd===d)
      .classed("src-hit", nd => d.outgoing.some(l=>l.target===nd))
      .classed("tgt-hit", nd => d.incoming.some(l=>l.source===nd));

  nodeDetail(d);
  showImage(d.data.name);
});

svg.on("mouseleave", resetHover);

function resetHover(){
  linkPaths.classed("out",false).classed("in",false).style("stroke-opacity",null);
  node.classed("hovered",false).classed("src-hit",false).classed("tgt-hit",false);
  hideImage();
  document.getElementById("detail").innerHTML = `<p class="empty">Hover any label on the diagram to see its sightlines listed here. Nodes with only grey edges (e.g. APAT, the apartment construction site) are never a vantage point in this log — only ever something that gets seen. Line dash pattern shows the visible feature — see the key on the poster itself.</p>`;
}
resetHover();
</script>
