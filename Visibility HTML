(function buildGrid(){
  let fineD = "", boldD = "";
  for(let x=FRAME.x; x<=FRAME.x+FRAME.w+0.01; x+=10){
    const d = `M${x.toFixed(2)},${FRAME.y} L${x.toFixed(2)},${FRAME.y+FRAME.h}`;
    if(Math.round(x)%50===0) boldD += d+" "; else fineD += d+" ";
  }
  for(let y=FRAME.y; y<=FRAME.y+FRAME.h+0.01; y+=10){
    const d = `M${FRAME.x},${y.toFixed(2)} L${FRAME.x+FRAME.w},${y.toFixed(2)}`;
    if(Math.round(y)%50===0) boldD += d+" "; else fineD += d+" ";
  }
  gridGroup.append("path").attr("id","GridFine").attr("class","grid-fine").attr("d",fineD.trim());
