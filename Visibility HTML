<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Physical/Direct Visibility Graph - Illithe</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
  :root{
    --bg:#000000;
    --ink:#ffffff;
    --ink-dim:#8b909c;
    --frame:#6b7280;
    --line:#3a4049;
    --out:#ff0000;
    --in:#ffffff;
    --idle-link:#abb5c4;
    --idle-node:#ff0000;
    --idle-width:.15;
    --hover-width:.2;
    --font-family:"IBM Plex Mono","SFMono-Regular",Consolas,monospace;
    --fs-title:7px;
    --fs-sub:2.6px;
    --fs-group:3.1px;
    --fs-node:2.2px;
    --fs-legend:2.7px;
    --fs-legend-head:2.3px;
    --fs-disclaimer:5.5px;
    --disclaimer-ink:#9aa1ad;
    --grid-opacity:.15;
    --grid-bold-opacity:.24;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0; background:#000000; color:var(--ink);
    font-family:"IBM Plex Mono","SFMono-Regular",Consolas,monospace;
  }
  #app{ display:grid; grid-template-columns: 1fr 320px; min-height:100vh; }
  #stage{
    display:flex; align-items:center; justify-content:center;
    padding:18px; background:#000000; position:relative;
  }
  #poster-wrap{ width:100%; max-width:1400px; }
  svg#viz{
    display:block; width:100%; height:auto; aspect-ratio:420/297;
    background:var(--bg);
  }
  text{ font-family:var(--font-family); }
  .frame{ fill:none; stroke:var(--frame); stroke-width:.35; }
  .tick{ fill:none; stroke:var(--frame); stroke-width:.35; }
  .grid-fine{ fill:none; stroke:var(--ink-dim); stroke-width:.12; opacity:var(--grid-opacity); }
  .grid-bold{ fill:none; stroke:var(--ink-dim); stroke-width:.2; opacity:var(--grid-bold-opacity); }
  .group-arc{ fill:none; stroke:var(--line); stroke-width:.6; }
  .guide-ring{ fill:none; stroke:var(--line); stroke-width:.3; }
  .group-label{ fill:var(--ink); font-size:var(--fs-group); letter-spacing:.04em; font-weight:700; }
  .node circle{ fill:var(--idle-node); stroke:none; }
  .node text{ fill:var(--ink-dim); font-size:var(--fs-node); cursor:default; }
  .node.hovered text{ fill:var(--ink); font-weight:700; }
  .node.src-hit text{ fill:var(--out); font-weight:600; }
  .node.tgt-hit text{ fill:var(--in); font-weight:600; }
  .link{ fill:none; stroke:var(--idle-link); stroke-opacity:.85; stroke-width:var(--idle-width); stroke-linecap:round; }
  .link.out{ stroke:var(--out); stroke-opacity:1; stroke-width:var(--hover-width); }
  .link.in{ stroke:var(--in); stroke-opacity:1; stroke-width:var(--hover-width); }
  .poster-title{ fill:var(--ink); font-size:var(--fs-title); font-weight:700; letter-spacing:.01em; }
  .poster-sub{ fill:var(--ink-dim); font-size:var(--fs-sub); letter-spacing:.02em; }
  .legend-text{ fill:var(--ink); font-size:var(--fs-legend); }
  .legend-head{ fill:var(--ink-dim); font-size:var(--fs-legend-head); letter-spacing:.06em; }
  .disclaimer{ fill:var(--disclaimer-ink); font-size:var(--fs-disclaimer); font-style:italic; }
  .knockout{ fill:var(--bg); stroke:none; }

  #panel{
    border-left:1px solid #262a31; padding:18px; background:#000000;
    overflow-y:auto; max-height:100vh; font-size:12px;
  }
  #panel h2{
    font-size:10.5px; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-dim);
    margin:0 0 4px; font-family:inherit;
  }
  #panel .id{ font-size:20px; font-weight:700; margin:0 0 2px; color:var(--ink); }
  #panel .desc{ font-size:12px; color:var(--ink-dim); margin:0 0 14px; }
  .legend{ display:flex; flex-direction:column; gap:8px; font-size:11px; color:var(--ink-dim); margin-bottom:16px;}
  .legend div{ display:flex; align-items:center; gap:8px; }
  .swatch{ width:18px; height:2px; border-radius:2px; }
  .rowgrp{ margin-bottom:14px; }
  .rowgrp h3{ font-size:10px; text-transform:uppercase; letter-spacing:.08em; margin:0 0 6px; }
  .rowgrp.out h3{ color:var(--out); }
  .rowgrp.in h3{ color:var(--in); }
  .conn{ font-size:11.5px; padding:5px 0; border-bottom:1px dashed #262a31; }
  .conn b{ color:var(--ink); }
  .conn span{ color:var(--ink-dim); display:block; font-size:10.5px; }
  .empty{ color:var(--ink-dim); font-size:12px; line-height:1.5; }
  /* hover picture. Put image files in a folder called "images" next to this
     HTML file, named after the node code: images/LAWN.jpg, images/B02.png ... */
  #nodeImg{ display:none; width:100%; height:auto; margin-bottom:10px; border:1px solid #262a31; }
  #imgHint{ display:none; font-size:9.5px; color:#4a4f57; margin:0 0 10px; font-style:italic; }
  #panel::-webkit-scrollbar{ width:6px; }
  #panel::-webkit-scrollbar-thumb{ background:#262a31; border-radius:3px; }
</style>
</head>
<body>
<div id="app">
  <div id="stage"><div id="poster-wrap"><svg id="viz" viewBox="0 0 420 297" xmlns="http://www.w3.org/2000/svg"></svg></div></div>
  <div id="panel">
    <div class="legend">
      <div><span class="swatch" style="background:var(--out)"></span> outgoing — this point can see</div>
      <div><span class="swatch" style="background:var(--in)"></span> incoming — is seen from</div>
    </div>
    <img id="nodeImg" alt="">
    <p id="imgHint"></p>
    <div id="detail"></div>
  </div>
</div>

